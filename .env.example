# Server configuration
PORT=8080
APP_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edu_db?sslmode=disable

# JWT Authentication
JWT_SECRET=super-secret-edu-platform-jwt-signing-key-32b!
JWT_EXPIRATION_HOURS=24

# LLM Copilot Configuration
# Provider: 'mock' (default, deterministic offline generation) or 'openai' (uses live API)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
