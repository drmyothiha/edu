# Server configuration
PORT=8080
APP_ENV=development

# Database configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/edu_db?sslmode=disable

# JWT Authentication
JWT_SECRET=super-secret-edu-platform-jwt-signing-key-32b!
JWT_EXPIRATION_HOURS=24

# LLM Copilot Configuration
# Provider options:
#  - 'mock' (default, offline deterministic generation)
#  - 'deepseek' (DeepSeek API: https://api.deepseek.com)
#  - 'openai' (OpenAI API: https://api.openai.com/v1)
#  - 'anthropic' (Anthropic API: https://api.anthropic.com/v1)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# For DeepSeek API:
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

